# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash

# Generated by generate_session.py
SESSION_STRING=PASTE_YOUR_TELETHON_STRING_SESSION_HERE

# Source channel. Examples:
# SOURCE_CHANNEL=@sourcechannel
# SOURCE_CHANNEL=-1001234567890
SOURCE_CHANNEL=@sourcechannel

# Destination channel. Your account must be able to post there.
DESTINATION_CHANNEL=@yourchannel

# Copy existing historical files on first/each startup.
# true = scan the complete accessible source history.
# false = only process new files after the bot starts.
BACKFILL_ON_START=false

INCLUDE_PHOTOS=true
INCLUDE_VIDEOS=true
INCLUDE_DOCUMENTS=true
INCLUDE_AUDIO=true
INCLUDE_VOICE=true
INCLUDE_STICKERS=false

# Delay between successful copies. Increase if Telegram rate-limits you.
DELAY_SECONDS=2

# SQLite state database
DB_PATH=/data/processed.sqlite3

LOG_LEVEL=INFO
STATUS_EVERY=100
